<view class="page">
  <view class="preview" id="preview">
    <camera id="camera" class="camera" device-position="back" flash="off" frame-size="small" bindinitdone="cameraReady" binderror="cameraError" />
    <canvas type="2d" id="outline" class="outline" />
  </view>
  <view class="controls">
    <text class="status">{{status}}</text>
    <button class="capture" loading="{{processing}}" disabled="{{processing || !ready}}" bindtap="capture">拍摄试卷</button>
    <view class="pages" wx:if="{{pages.length}}">
      <image wx:for="{{pages}}" wx:key="path" class="thumb" src="{{item.path}}" mode="aspectFit" data-index="{{index}}" bindtap="previewPage" />
    </view>
    <text class="count" wx:if="{{pages.length}}">已处理 {{pages.length}} 页 · 点击查看大图</text>
  </view>
</view>
