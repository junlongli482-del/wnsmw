page{height:100%;background:#17252b;color:#f4f7f8}.page{height:100%;display:flex;flex-direction:column}.preview{position:relative;flex:1;overflow:hidden;min-height:240px}.camera,.outline{position:absolute;width:100%;height:100%;left:0;top:0}.outline{pointer-events:none}.controls{padding:24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));display:flex;flex-direction:column;gap:20rpx}.status{text-align:center;font-size:28rpx;min-height:40rpx}.capture{width:100%;border-radius:16rpx;background:#a9f0cf;color:#12261f;font-weight:600}.capture[disabled]{background:#586761;color:#d3dcd7}.pages{display:flex;gap:12rpx;overflow-x:auto}.thumb{width:110rpx;height:140rpx;flex-shrink:0;background:white;border-radius:8rpx}.count{text-align:center;font-size:24rpx;color:#bbc9cf}
